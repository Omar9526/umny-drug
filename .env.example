# ---------------------------------------------------------------------------
# «Умный друг» — environment template. Copy to .env and fill in real values.
# Never commit .env. Production uses only real services and secrets.
# ---------------------------------------------------------------------------

# development | test | production
ENVIRONMENT=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Trusted reverse proxies in front of Django (0 = ignore X-Forwarded-For entirely).
NUM_PROXIES=0
# Separate JWT signing key (defaults to DJANGO_SECRET_KEY). Rotating it logs everyone out.
JWT_SIGNING_KEY=
# Non-obvious admin path, e.g. ops-7f3a/
DJANGO_ADMIN_PATH=admin/

# Dev fallback for machines without Docker/PostgreSQL/Redis.
# SQLite + eager Celery + local private storage. Refused when ENVIRONMENT=production.
DEV_FALLBACK=1

# Full stack (docker compose / production)
DATABASE_URL=postgres://umnydrug:umnydrug@db:5432/umnydrug
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Storage: local (dev fallback) | s3
STORAGE_BACKEND=local
S3_BUCKET=umnydrug-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1

# AI provider: auto (anthropic when key present, otherwise demo) | anthropic | demo
AI_PROVIDER=auto  # auto | anthropic | gemini | demo
# Gemini (альтернатива Claude): AI_PROVIDER=auto  # auto | anthropic | gemini | demo выбирает Anthropic → Gemini → demo по наличию ключей
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_VISION=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
ANTHROPIC_API_KEY=
AI_MODEL_VISION=claude-opus-5-5
AI_MODEL_TUTOR=claude-opus-5-5
AI_MODEL_VERIFY=claude-opus-5-5
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=4096
AI_DAILY_BUDGET_USD=25
AI_DAILY_BUDGET_PER_FAMILY_USD=2
AI_DAILY_CALLS_PER_STUDENT=150
# Optional price override per model, USD per million tokens
# AI_PRICING_JSON={"claude-opus-5-5":{"input":4,"output":20,"cache_read":0.2,"cache_write":5}}
AI_HISTORY_TURNS=24

# Auth cookies
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
AUTH_COOKIE_SECURE=0
AUTH_COOKIE_SAMESITE=Lax

# Child-safety / retention policy
CHILD_PIN_MAX_ATTEMPTS=5
CHILD_PIN_LOCK_MINUTES=15
CHILD_PIN_MAX_LOCKOUTS=3
ASSIGNMENT_IMAGE_RETENTION_DAYS=30
MAX_UPLOAD_IMAGE_MB=10
MAX_UPLOAD_IMAGES_PER_ASSIGNMENT=5
MAX_IMAGE_PIXELS=40000000
CONSENT_TERMS_VERSION=2026-10-01

# Frontend (public values only — anything NEXT_PUBLIC_* ends up in the browser bundle)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Умный друг

# Postgres container bootstrap (compose only)
POSTGRES_DB=umnydrug
POSTGRES_USER=umnydrug
POSTGRES_PASSWORD=umnydrug
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-change-me
